# === Raw & large data files — excluded from version control ===
2_data/raw/*
!2_data/raw/.gitkeep

# === data_cleaning.ipynb generated outputs (regenerated by re-running the notebook) ===
2_data/processed/raw_predictor_audit.csv
2_data/processed/model_panels/
4_analysis/figures/predictorsv1/*
!4_analysis/figures/predictorsv1/.gitkeep
4_analysis/figures/model_panels/

# === Python artifacts ===
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.cache/
tests/*
!tests/test_*.py
tests/__pycache__/

# === Local contributor-agent notes ===
AGENTS.md

# === Local Codex staging and compile copies ===
.codex_stage/

# === Virtual environments ===
venv/
.venv/
env/

# === Generated model outputs & figures — kept local only, regenerated by scripts ===
# Model result tables/summaries (regenerate: python 3_models/scripts/run_modeling.py --both)
3_models/outputs/*.csv
3_models/outputs/*.md
3_models/outputs/*.pkl
3_models/outputs/*.joblib
3_models/outputs/tree/
!3_models/outputs/.gitkeep
# Model figures (regenerate: run_modeling.py + paper_figures.py)
4_analysis/figures/modeling/
4_analysis/figures/tree_modeling/
4_analysis/figures/paper/

# === Secrets & credentials ===
.env
*.key
*.pem
credentials.json

# === macOS system files ===
.DS_Store

# === IDE & editor config ===
.vscode/
.idea/

# === LaTeX build artifacts ===
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.pdf
