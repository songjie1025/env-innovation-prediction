# === Raw & large data files — excluded from version control ===
2_data/raw/*
!2_data/raw/.gitkeep

# === data_cleaning.ipynb generated outputs (regenerated by re-running the notebook) ===
2_data/processed/raw_predictor_audit.csv
2_data/processed/model_panels/
4_analysis/figures/predictorsv1/*
!4_analysis/figures/predictorsv1/.gitkeep
4_analysis/figures/model_panels/

# === Python artifacts ===
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.cache/
tests/*
!tests/test_*.py
tests/__pycache__/

# === Virtual environments ===
venv/
.venv/
env/

# === Trained model files (too large for Git) ===
3_models/outputs/*.pkl
3_models/outputs/*.joblib

# === Secrets & credentials ===
.env
*.key
*.pem
credentials.json

# === macOS system files ===
.DS_Store

# === IDE & editor config ===
.vscode/
.idea/

# === LaTeX build artifacts ===
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.pdf
